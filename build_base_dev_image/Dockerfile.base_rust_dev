################################################################################
# Rust Development Environment - Version 0.8.3
# Shared Dockerfile for all environments (dev, test, prod)
#
# Changes in v0.8.3:
# - Added docker-entrypoint.sh (ENTRYPOINT): fixes rustdev's docker CLI
#   access to the bind-mounted /var/run/docker.sock under Docker Desktop,
#   whose Linux VM owns the socket as root:root instead of matching this
#   image's docker group (999) the way Rancher Desktop's VM did.
#
# Changes in v0.8.2:
# - Removed github.copilot / github.copilot-chat from the default VS Code
#   extension list (install_vscode_extensions.sh, devcontainer.json): both
#   consistently failed to install and neither is part of this environment's
#   AI stack (Claude Code + QMD + Graphify + gstack).
#
# Changes in v0.8.1:
# - Fixed QMD's native sqlite binding: npm 12's install-scripts hardening
#   silently blocked better-sqlite3/node-llama-cpp/tree-sitter-* postinstall
#   scripts, leaving every index/query operation crashing at runtime even
#   though `qmd --version` and the CLI itself worked fine. Fixed with
#   --allow-scripts on the npm install (see deploy_dev_env/Dockerfile.rust-dev
#   for the analogous fix to Claude Code's install).
#
# Changes in v0.8.0:
# - Added Graphify (AI code knowledge graph) next to QMD: uv + graphifyy[mcp]
#   installed globally. Code-only extraction needs no GGUF models or API key
#   (pure tree-sitter AST + networkx), so no new volume is required.
#
# Changes in v0.7.1:
# - Upgraded Node.js from 20 to 22 (required by QMD engine constraint >=22)
# - Fixed QMD installation: switched from bun+GitHub source to npm registry
#   (npm package includes pre-built dist/; no bun.lock -> wrapper uses node)
# 
# Changes in v0.7.0:
# - Added Playwright with Chromium (required for gstack /browse skill)
# - System-level browser dependencies for headless browsing
# 
################################################################################
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

################################################################################
# Install System Dependencies
################################################################################
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    vim \
    nano \
    htop \
    tree \
    unzip \
    build-essential \
    pkg-config \
    libssl-dev \
    openssh-server \
    sudo \
    gnupg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Ensure Let's Encrypt root is present and up to date
RUN update-ca-certificates

################################################################################
# Install Node.js (Runtime for Claude Code & Tooling)
################################################################################
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g npm@latest

################################################################################
# Install Bun Runtime (Required for QMD)
################################################################################
USER root
# Set installation location before running install script
ENV BUN_INSTALL="/usr/local"
RUN curl -fsSL https://bun.sh/install | bash

# Verify Bun installation (bunx is automatically created by installer)
RUN bun --version

ENV PATH="${BUN_INSTALL}/bin:${PATH}"

################################################################################
# Install Playwright with Chromium (Required for gstack /browse skill)
################################################################################
# Install system dependencies required by Chromium/Playwright
RUN apt-get update && apt-get install -y \
    libgbm1 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright Chromium browser using Bun
RUN bunx playwright install chromium

################################################################################
# Install MongoDB Shell (mongosh)
################################################################################
RUN curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | \
    gpg -o /usr/share/keyrings/mongodb-server-7.0.gpg --dearmor && \
    echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" | \
    tee /etc/apt/sources.list.d/mongodb-org-7.0.list && \
    apt-get update && \
    apt-get install -y mongodb-mongosh && \
    rm -rf /var/lib/apt/lists/*

################################################################################
# Install GitHub CLI
################################################################################
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
    gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | \
    tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

################################################################################
# Install Docker CLI
################################################################################
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
    gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu jammy stable" | \
    tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

################################################################################
# User Configuration Arguments
################################################################################
ARG USERNAME=rustdev
ARG USER_UID=1026
ARG GROUPNAME=rustdevteam
ARG USER_GID=110
ARG GIT_USER_NAME=""
ARG GIT_USER_EMAIL=""

################################################################################
# Create Development User with Docker Access
################################################################################
# Create docker group with GID that typically matches Docker socket group
# Note: On most systems docker.sock is owned by root:docker (GID varies)
# On Windows Docker Desktop, it may be owned by systemd-journal (GID 101)
# We'll create the group and add user; socket permissions handled at runtime
RUN groupadd --gid 999 docker || true && \
    groupadd --gid ${USER_GID} ${GROUPNAME} || true && \
    useradd --uid ${USER_UID} --gid ${USER_GID} --shell /bin/bash -m ${USERNAME} || true && \
    usermod -aG sudo ${USERNAME} && \
    usermod -aG docker ${USERNAME} && \
    usermod -aG systemd-journal ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} && \
    chmod 0440 /etc/sudoers.d/${USERNAME}

WORKDIR /home/${USERNAME}

################################################################################
# Install Rust Toolchain
################################################################################
USER ${USERNAME}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable && \
    . /home/${USERNAME}/.cargo/env && \
    /home/${USERNAME}/.cargo/bin/rustup default stable && \
    /home/${USERNAME}/.cargo/bin/cargo --version && \
    /home/${USERNAME}/.cargo/bin/rustc --version && \
    bash -c "echo '. /home/${USERNAME}/.cargo/env' >> /home/${USERNAME}/.bashrc" && \
    bash -c "echo '. /home/${USERNAME}/.cargo/env' >> /home/${USERNAME}/.profile"

ENV PATH="/home/${USERNAME}/.cargo/bin:${PATH}"

# Configure Rust cache directories and environment variables for optimal performance
RUN mkdir -p /home/${USERNAME}/.cargo/git/db && \
    mkdir -p /home/${USERNAME}/.cargo/registry/index && \
    mkdir -p /home/${USERNAME}/.cargo/registry/cache && \
    mkdir -p /home/${USERNAME}/.cargo/registry/src && \
    mkdir -p /home/${USERNAME}/.rustup

# Set Rust environment variables for optimal caching and performance
ENV CARGO_HOME=/home/${USERNAME}/.cargo
ENV RUSTUP_HOME=/home/${USERNAME}/.rustup
ENV CARGO_INCREMENTAL=1
ENV CARGO_BUILD_JOBS=4
ENV RUST_BACKTRACE=1

################################################################################
# Configure Git (if credentials provided)
################################################################################
USER ${USERNAME}
ARG GIT_USER_NAME
ARG GIT_USER_EMAIL
RUN if [ -n "${GIT_USER_NAME}" ] && [ -n "${GIT_USER_EMAIL}" ]; then \
        git config --global user.name "${GIT_USER_NAME}" && \
        git config --global user.email "${GIT_USER_EMAIL}"; \
    fi

################################################################################
# Configure SSH Server
################################################################################
USER root

RUN mkdir -p /var/run/sshd && \
    mkdir -p /home/${USERNAME}/.ssh && \
    chown ${USER_UID}:${USER_GID} /home/${USERNAME}/.ssh && \
    chmod 700 /home/${USERNAME}/.ssh

RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -i 's/PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/#AuthorizedKeysFile/AuthorizedKeysFile/' /etc/ssh/sshd_config && \
    sed 's@session\s*required\s*pam_loginuid.so@session optional pam_loginuid.so@g' -i /etc/pam.d/sshd

# Generate SSH host keys
RUN ssh-keygen -A

# Copy placeholder authorized_keys (will be overridden by environment-specific builds)
# Each environment should provide its own authorized_keys file
COPY authorized_keys.template /home/${USERNAME}/.ssh/authorized_keys

RUN chown ${USER_UID}:${USER_GID} /home/${USERNAME}/.ssh/authorized_keys && \
    chmod 600 /home/${USERNAME}/.ssh/authorized_keys

EXPOSE 22

################################################################################
# VS Code Extension Auto-Install Setup
################################################################################
USER root

# Copy extension installation script and devcontainer.json
COPY install_vscode_extensions.sh /home/${USERNAME}/install_vscode_extensions.sh
COPY devcontainer.json /home/${USERNAME}/.devcontainer.json

RUN chmod +x /home/${USERNAME}/install_vscode_extensions.sh && \
    chown ${USER_UID}:${USER_GID} /home/${USERNAME}/install_vscode_extensions.sh && \
    chown ${USER_UID}:${USER_GID} /home/${USERNAME}/.devcontainer.json

USER ${USERNAME}

# Add message to bashrc to prompt extension installation on first login
RUN echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# VS Code Extensions Setup' >> /home/${USERNAME}/.bashrc && \
    echo 'if [ ! -f ~/.vscode_extensions_installed ]; then' >> /home/${USERNAME}/.bashrc && \
    echo '    echo ""' >> /home/${USERNAME}/.bashrc && \
    echo '    echo "========================================="' >> /home/${USERNAME}/.bashrc && \
    echo '    echo "VS Code Extensions Auto-Install"' >> /home/${USERNAME}/.bashrc && \
    echo '    echo "========================================="' >> /home/${USERNAME}/.bashrc && \
    echo '    echo ""' >> /home/${USERNAME}/.bashrc && \
    echo '    echo "Installing recommended VS Code extensions..."' >> /home/${USERNAME}/.bashrc && \
    echo '    if ~/install_vscode_extensions.sh 2>/dev/null; then' >> /home/${USERNAME}/.bashrc && \
    echo '        touch ~/.vscode_extensions_installed' >> /home/${USERNAME}/.bashrc && \
    echo '        echo ""' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "✓ Extensions installed successfully!"' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "  Please reload VS Code window: Ctrl+Shift+P -> Reload Window"' >> /home/${USERNAME}/.bashrc && \
    echo '        echo ""' >> /home/${USERNAME}/.bashrc && \
    echo '    else' >> /home/${USERNAME}/.bashrc && \
    echo '        echo ""' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "Note: Extensions will be installed on next terminal session."' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "Or run manually: ~/install_vscode_extensions.sh"' >> /home/${USERNAME}/.bashrc && \
    echo '        echo ""' >> /home/${USERNAME}/.bashrc && \
    echo '    fi' >> /home/${USERNAME}/.bashrc && \
    echo 'fi' >> /home/${USERNAME}/.bashrc

################################################################################
# Common Shell Aliases and Git Shortcuts
################################################################################
USER ${USERNAME}

# Add common shell aliases
RUN echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# Common Shell Aliases' >> /home/${USERNAME}/.bashrc && \
    echo 'alias ll="ls -alF"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias la="ls -A"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias l="ls -CF"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias ..="cd .."' >> /home/${USERNAME}/.bashrc && \
    echo 'alias ...="cd ../.."' >> /home/${USERNAME}/.bashrc && \
    echo 'alias grep="grep --color=auto"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias fgrep="fgrep --color=auto"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias egrep="egrep --color=auto"' >> /home/${USERNAME}/.bashrc

# Add Git aliases
RUN git config --global alias.st status && \
    git config --global alias.co checkout && \
    git config --global alias.br branch && \
    git config --global alias.ci commit && \
    git config --global alias.unstage 'reset HEAD --' && \
    git config --global alias.last 'log -1 HEAD' && \
    git config --global alias.visual '!gitk' && \
    git config --global alias.lg "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"

# Add Cargo shortcuts
RUN echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# Cargo Shortcuts' >> /home/${USERNAME}/.bashrc && \
    echo 'alias cb="cargo build"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias cr="cargo run"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias ct="cargo test"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias cc="cargo check"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias ccl="cargo clippy"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias cf="cargo fmt"' >> /home/${USERNAME}/.bashrc && \
    echo 'alias cu="cargo update"' >> /home/${USERNAME}/.bashrc

################################################################################
# QMD - Query Markup Documents (AI-optimized code indexing)
# Install in base image to avoid re-downloading on every deployment
################################################################################
USER root

# Install QMD globally using npm (npm registry has pre-built dist/; no bun.lock -> wrapper uses node).
# --allow-scripts is required: npm 12's install-scripts hardening blocks
# native-module postinstall/build scripts by default (better-sqlite3,
# node-llama-cpp, tree-sitter-*) unless explicitly allow-listed, which left
# QMD's sqlite backend unbuilt (native binding missing -> every index/query
# failed at runtime, even though `qmd --version` and the CLI itself worked).
RUN npm install -g --allow-scripts=better-sqlite3,node-llama-cpp,tree-sitter-go,tree-sitter-python,tree-sitter-rust,tree-sitter-typescript,tree-sitter-javascript @tobilu/qmd

# Verify QMD installation
RUN qmd --version || echo "QMD installed, waiting for first use to download models"

# Create QMD directories with proper permissions from the start
RUN mkdir -p /home/${USERNAME}/.local/share && \
    mkdir -p /home/${USERNAME}/.cache/qmd && \
    chown -R ${USER_UID}:${USER_GID} /home/${USERNAME}/.local && \
    chown -R ${USER_UID}:${USER_GID} /home/${USERNAME}/.cache

# Add QMD to PATH
USER ${USERNAME}
RUN echo 'export PATH="$HOME/.bun/bin:/usr/local/bin:$PATH"' >> /home/${USERNAME}/.bashrc

# Configure Claude Code MCP integration for QMD
# Create .claude directory (will be bind mounted from Windows)
USER root
RUN mkdir -p /home/${USERNAME}/.claude && \
    chown -R ${USER_UID}:${USER_GID} /home/${USERNAME}/.claude

# Create symlink: ~/.claude.json -> ~/.claude/claude.json for eternal persistence
# Claude Code manages .claude.json, symlinking it to .claude/ makes it eternal
USER ${USERNAME}
RUN ln -s /home/${USERNAME}/.claude/claude.json /home/${USERNAME}/.claude.json

# Add QMD shortcuts and auto-init function to bashrc
# Per-repo aliases (qmd-{name}=...) are added at runtime by init_qmd.sh.
# These generic helpers work across all projects.
USER ${USERNAME}
RUN echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# QMD Shortcuts (generic — per-project aliases added by init_qmd.sh)' >> /home/${USERNAME}/.bashrc && \
    echo 'alias qmd-reindex="~/init_qmd.sh"' >> /home/${USERNAME}/.bashrc && \
    echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# qmd-status: show status for every per-repo index' >> /home/${USERNAME}/.bashrc && \
    echo 'function qmd-status() {' >> /home/${USERNAME}/.bashrc && \
    echo '    local found=0' >> /home/${USERNAME}/.bashrc && \
    echo '    for symlink in "$HOME"/.cache/qmd/*.sqlite; do' >> /home/${USERNAME}/.bashrc && \
    echo '        [ -L "$symlink" ] || continue' >> /home/${USERNAME}/.bashrc && \
    echo '        found=1' >> /home/${USERNAME}/.bashrc && \
    echo '        local name; name=$(basename "$symlink" .sqlite)' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "=== $name ==="' >> /home/${USERNAME}/.bashrc && \
    echo '        qmd --index "$name" status 2>/dev/null || echo "(not initialized)"' >> /home/${USERNAME}/.bashrc && \
    echo '    done' >> /home/${USERNAME}/.bashrc && \
    echo '    if [ "$found" -eq 0 ]; then echo "No per-repo QMD indexes found. Run: ~/init_qmd.sh"; fi' >> /home/${USERNAME}/.bashrc && \
    echo '}' >> /home/${USERNAME}/.bashrc && \
    echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# QMD Auto-Initialize on first login (per-repo mode)' >> /home/${USERNAME}/.bashrc && \
    echo 'function qmd-auto-init() {' >> /home/${USERNAME}/.bashrc && \
    echo '    # Only run for interactive shells' >> /home/${USERNAME}/.bashrc && \
    echo '    [ -n "$PS1" ] || return' >> /home/${USERNAME}/.bashrc && \
    echo '    ' >> /home/${USERNAME}/.bashrc && \
    echo '    # Check whether any per-repo index symlink exists' >> /home/${USERNAME}/.bashrc && \
    echo '    if ! ls "$HOME"/.cache/qmd/*.sqlite 2>/dev/null | grep -q .; then' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "QMD not initialized. Running auto-init..."' >> /home/${USERNAME}/.bashrc && \
    echo '        ~/init_qmd.sh' >> /home/${USERNAME}/.bashrc && \
    echo '        return' >> /home/${USERNAME}/.bashrc && \
    echo '    fi' >> /home/${USERNAME}/.bashrc && \
    echo '    ' >> /home/${USERNAME}/.bashrc && \
    echo '    # Warn if the newest index symlink target is >24h old' >> /home/${USERNAME}/.bashrc && \
    echo '    NEWEST=$(ls -t "$HOME"/.cache/qmd/*.sqlite 2>/dev/null | head -1)' >> /home/${USERNAME}/.bashrc && \
    echo '    if [ -n "$NEWEST" ]; then' >> /home/${USERNAME}/.bashrc && \
    echo '        LAST_UPDATE=$(stat -c %Y "$(readlink -f "$NEWEST")" 2>/dev/null || echo 0)' >> /home/${USERNAME}/.bashrc && \
    echo '        NOW=$(date +%s)' >> /home/${USERNAME}/.bashrc && \
    echo '        if [ $(( NOW - LAST_UPDATE )) -gt 86400 ]; then' >> /home/${USERNAME}/.bashrc && \
    echo '            echo "QMD index is >24h old. Consider running: qmd-{name} update"' >> /home/${USERNAME}/.bashrc && \
    echo '        fi' >> /home/${USERNAME}/.bashrc && \
    echo '    fi' >> /home/${USERNAME}/.bashrc && \
    echo '}' >> /home/${USERNAME}/.bashrc && \
    echo 'qmd-auto-init' >> /home/${USERNAME}/.bashrc

################################################################################
# Graphify - AI Code Knowledge Graph (structural/call-graph code search)
# Complements QMD: QMD answers content/semantic questions, Graphify answers
# structural questions (call graphs, path tracing). Install in base image to
# avoid re-downloading on every deployment.
#
# IMPORTANT: installed into /usr/local (like Bun), NOT ~/.local. On
# deployment, /home/${USERNAME} is a persistent named volume, and Docker
# only seeds a volume's content from the image the FIRST time that volume
# is created — anything added under /home/${USERNAME} in a later image
# build is invisible on every subsequent redeploy against an
# already-existing volume. A system-wide install under /usr/local avoids
# that class of bug entirely (already-existing deployments pick up new
# base-image tools automatically, no self-healing init script needed).
################################################################################
USER root

# Install uv (Python package/tool manager) - required to install Graphify.
# UV_INSTALL_DIR places the uv binary itself in /usr/local/bin.
ENV UV_INSTALL_DIR="/usr/local/bin"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Verify uv installation
RUN uv --version

# Install Graphify globally as a uv tool. UV_TOOL_DIR/UV_TOOL_BIN_DIR place
# the tool's venv and shims under /usr/local too, for the same reason as
# above. Code-only extraction (used here) needs no GGUF models or API key:
# pure tree-sitter AST + networkx. tomli is required for --cargo (Cargo
# workspace introspection) on Python 3.10 (Ubuntu 22.04's stock Python) —
# Python 3.11+ ships this as the built-in tomllib, but we're on 3.10.
ENV UV_TOOL_DIR="/usr/local/share/uv/tools"
ENV UV_TOOL_BIN_DIR="/usr/local/bin"
RUN uv tool install "graphifyy[mcp]" --with tomli

# Verify Graphify installation
RUN graphify --version || echo "Graphify installed"

USER ${USERNAME}

# Add Graphify shortcuts and status helper to bashrc
# Per-repo state lives in {repo}/graphify-out/ (path-based scoping, no
# --index flag like QMD). init_graphify.sh (deployment-specific) wires each
# repo: extraction, Claude Code project install, and the git commit hook.
RUN echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# Graphify Shortcuts (generic — per-repo setup done by init_graphify.sh)' >> /home/${USERNAME}/.bashrc && \
    echo 'alias graphify-reindex="~/init_graphify.sh"' >> /home/${USERNAME}/.bashrc && \
    echo '' >> /home/${USERNAME}/.bashrc && \
    echo '# graphify-status: show graph status for every repo with a graphify-out/' >> /home/${USERNAME}/.bashrc && \
    echo 'function graphify-status() {' >> /home/${USERNAME}/.bashrc && \
    echo '    local found=0' >> /home/${USERNAME}/.bashrc && \
    echo '    for graph in "$HOME"/*/graphify-out/graph.json /workspace/*/graphify-out/graph.json /workspace/graphify-out/graph.json; do' >> /home/${USERNAME}/.bashrc && \
    echo '        [ -f "$graph" ] || continue' >> /home/${USERNAME}/.bashrc && \
    echo '        found=1' >> /home/${USERNAME}/.bashrc && \
    echo '        repo_dir=$(dirname "$(dirname "$graph")")' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "=== $(basename "$repo_dir") ==="' >> /home/${USERNAME}/.bashrc && \
    echo '        echo "  $graph ($(wc -c < "$graph") bytes)"' >> /home/${USERNAME}/.bashrc && \
    echo '    done' >> /home/${USERNAME}/.bashrc && \
    echo '    if [ "$found" -eq 0 ]; then echo "No Graphify graphs found. Run: ~/init_graphify.sh"; fi' >> /home/${USERNAME}/.bashrc && \
    echo '}' >> /home/${USERNAME}/.bashrc

################################################################################
# Workspace Setup
################################################################################
USER root
RUN mkdir -p /workspace && chown ${USER_UID}:${USER_GID} /workspace

################################################################################
# Container Startup
################################################################################
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["/usr/sbin/sshd", "-D"]
